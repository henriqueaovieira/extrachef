NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only admin credentials. Prefer SERVICE_ROLE_KEY; SECRET_KEY is an alternative.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional server-only URL fallback; must target the same project as the public URL.
SUPABASE_URL=
NEXT_PUBLIC_APP_URL=
# Required in the browser at build time. VAPID_PUBLIC_KEY alone is not consumed.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Optional server override; must equal NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:suporte@seudominio.com
PUSH_WEBHOOK_SECRET=
# Server-only. Base URL of a Photon instance, without /api or /reverse; no implicit public endpoint.
GEOCODING_PROVIDER=photon
GEOCODING_ENDPOINT=
# Milliseconds (1000-30000) and seconds (60-7776000), respectively.
GEOCODING_TIMEOUT=10000
GEOCODING_CACHE_TTL=7776000
# Temporary metadata-only diagnostics; disable and redeploy after investigation.
PUSH_DIAGNOSTICS_ENABLED=false